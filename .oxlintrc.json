{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Главное правило здесь — запрет импорта `three` вне папки сцены.
  // `three` весит около 230 КБ gzip и обязан оставаться в ленивом чанке. Один
  // импорт в модуле, который тянется из `App`, отменяет всю схему: так уже
  // случалось, когда `useStationHash` взял математику из `route.ts`, и главный
  // чанк вырос с 63 до 160 КБ. Проверка размера бандла ловит это только после
  // сборки, линтер — сразу.
  "plugins": ["typescript", "react"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["dist", "dist-ssr", "coverage", "playwright-report", "test-results"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "three",
            "message": "three допустим только в каталогах scene/ (src/features/*/scene/, src/widgets/scene/) — он обязан остаться в ленивом чанке. Чистую математику берите из @/entities/route/progress."
          },
          {
            // `leva` — только для разработки (спека §3.3). У неё нет
            // `"sideEffects": false`, поэтому статический импорт, даже
            // используемый лишь под `import.meta.env.DEV`, Rollup не вырезает:
            // проверено сборкой, +66 КБ gzip каждому посетителю. Oxlint видит
            // и динамический `import()`, поэтому единственный загрузчик под
            // `DEV` подавляет правило точечно, как `App.tsx`. Сборку
            // дополнительно проверяет `check:size` по маркерам leva.
            "name": "leva",
            "message": "leva — только для разработки. Подключайте её динамическим import() под import.meta.env.DEV: статический импорт под тем же условием не вырезается из продакшен-сборки."
          }
        ],
        "patterns": [
          {
            "group": ["three/*"],
            "message": "three допустим только в каталогах scene/ (src/features/*/scene/, src/widgets/scene/)."
          },
          {
            // Утечка 2026-09: `useStationHash.ts` статически подключён из
            // `App`, но брал математику из `./route`, который тянет `three` —
            // главный чанк вырос с 63 до 160 КБ. `no-restricted-imports` по
            // спецификатору `three` этот случай не ловит: импортировался не
            // `three`, а модуль, который тянет его транзитивно. Поэтому
            // запрещён весь каталог ленивого поддерева `scene/` — по
            // относительному пути (`./scene/…` из `career-flight`,
            // `../scene/…` из соседнего подкаталога) и по любому пути,
            // содержащему `scene/…` (алиас `@/…` или длинный относительный).
            // Любой каталог `scene/` — ленивый. Поэтому стор режимов сцены,
            // живущий в главном чанке, называется `entities/scene-mode`, а не
            // `entities/scene`. Правило каталожное, а не по списку
            // файлов: новый модуль сцены защищён с момента, как положен в
            // `scene/`, и забыть внести его в шаблоны невозможно.
            "group": ["./scene/**", "../scene/**", "**/scene/**"],
            "message": "Модули каталогов scene/ (src/features/*/scene/, src/widgets/scene/) тянут three и обязаны оставаться в ленивом чанке. Чистую математику берите из @/entities/…; SceneLayer подключайте только через lazy(() => import(...))."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Ленивые поддеревья сцены: `scene/` каждой фичи и виджет, собирающий
      // канвас, — единственное место, где допустимы прямой
      // импорт `three` и импорт модулей сцены друг другом. Граница проходит
      // по каталогу: всё, что тянет `three`, кладётся в `scene/`; всё, что
      // подключено из `App` статически (`useStationHash.ts`, `stationHash.ts`),
      // лежит уровнем выше и остаётся под запретом.
      //
      // Правило здесь переопределено, а не выключено: запрет на `leva`
      // действует и внутри сцены — именно сюда фаза 2 и положит панель.
      // `"off"` молча снимал бы его (проверено пробным файлом).
      "files": ["src/features/*/scene/**", "src/widgets/scene/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "leva",
                "message": "leva — только для разработки. Подключайте её динамическим import() под import.meta.env.DEV: статический импорт под тем же условием не вырезается из продакшен-сборки."
              }
            ]
          }
        ]
      }
    }
  ]
}
